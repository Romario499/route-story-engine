{
  "name": "route-story-engine",
  "version": "1.0.0",
  "description": "GPS track or travel waypoints → animated video story (9:16 / 16:9) right in the browser: MapLibre + Canvas + WebCodecs.",
  "license": "MIT",
  "author": "NRM",
  "homepage": "https://romario499.github.io/route-story-engine/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Romario499/route-story-engine.git"
  },
  "keywords": [
    "gps",
    "gpx",
    "kml",
    "organic-maps",
    "maplibre",
    "webcodecs",
    "video",
    "travel",
    "storytelling",
    "typescript",
    "vite"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "build:geodata": "node scripts/build-geodata.mjs",
    "build:sample": "node scripts/build-sample.mjs",
    "test:e2e": "playwright test",
    "exports": "node scripts/make-exports.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/pt-serif": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "flag-icons": "7.5.0",
    "maplibre-gl": "4.7.1",
    "mp4-muxer": "5.2.2",
    "webm-muxer": "5.1.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "mp4box": "2.4.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
